# Guardian Connect backend — environment variables
# Copy to .env and fill in. NEVER commit real values.

# --- Core ---
NODE_ENV=development
PORT=3001
JWT_SECRET=change-me-long-random-string

# --- Database (Railway provides DATABASE_URL) ---
DATABASE_URL=postgres://user:password@host:5432/guardian_connect
# or individual vars: PGHOST / PGPORT / PGDATABASE / PGUSER / PGPASSWORD

# --- CORS: comma-separated list of allowed web origins ---
ALLOWED_ORIGINS=https://guardianconnect.icu,https://www.guardianconnect.icu

# --- Rate limiting (ON by default; set true ONLY for local dev) ---
# DISABLE_RATE_LIMIT=true

# --- Firebase Cloud Messaging (mobile push) ---
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=

# --- Web Push (VAPID) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@guardianconnect.icu

# --- Agora video calling ---
# App ID is safe-ish to expose to clients; the CERTIFICATE is a SECRET.
AGORA_APP_ID=
# Optional: enables token-authenticated channels (recommended for production)
AGORA_APP_CERTIFICATE=

# --- Email (verification / password reset / invitations) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Guardian Connect <no-reply@guardianconnect.icu>

# --- App URLs ---
APP_URL=https://guardianconnect.icu

# --- Stripe (donations/subscriptions; currently feature-flagged off) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
